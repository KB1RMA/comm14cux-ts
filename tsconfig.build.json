{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"incremental": false,
		"rootDir": "./src",
		"outDir": "./dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"inlineSources": true,
		"types": ["w3c-web-serial"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test-support/**"]
}
